# Copy to .env (Docker) or set in your shell. Everything here can also be changed later in the dashboard.

# Optional: preset the dashboard password (otherwise you create it on first visit)
# PORTAL_ADMIN_PASSWORD=change-me-please

# AWS auth mode: assume_role | default_chain | static_keys
PORTAL_AWS_AUTH_MODE=assume_role
PORTAL_AWS_REGION=us-east-1
# RoleArn output of infra/bedrock-portal-role.yaml
PORTAL_AWS_ROLE_ARN=
# Must match the ExternalId you deployed the CloudFormation stack with
PORTAL_AWS_EXTERNAL_ID=
# Named profile used as the *source* credentials to assume the role (leave empty for the default chain)
PORTAL_AWS_PROFILE=

# Where the SQLite database and generated images live
# PORTAL_DATA_DIR=./data
